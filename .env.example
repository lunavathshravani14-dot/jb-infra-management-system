# Database connection string (SQLite file path or PostgreSQL URL)
DATABASE_URL="file:./dev.db"

# JWT secret key for signing auth tokens
JWT_SECRET="your-jwt-secret-key-change-in-production"

# AES 256-bit encryption key (32 characters) for encrypting sensitive documents
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef"

# WhatsApp Cloud API credentials (Optional)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_NAME="jb_infra_id_approved"

# App URL (set to your production domain on deployment)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="production"
